<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <h2><%= appName %></h2>
      <p class="local-pill">Offline Private</p>

      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/invoices">Invoices</a>
        <a href="/customers">Customers</a>
        <a href="/expenses" class="active">Expenses</a>
        <a href="/suppliers">Suppliers</a>
        <a href="#">Reports</a>
        <a href="/exports">Exports</a>
        <a href="/settings">Settings</a>
      </nav>
    </aside>

    <main class="dashboard">
      <header class="dashboard-header">
        <div>
          <p class="eyebrow">Money spent by the business</p>
          <h1>Expenses</h1>
        </div>
        <a href="/expenses/new" class="btn primary">Add Expense</a>
      </header>

      <section class="panel">
        <% if (expenses.length === 0) { %>
          <p class="muted">No expenses yet. Add your first expense to track costs and VAT reclaimable.</p>
        <% } else { %>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Supplier</th>
                  <th>Category</th>
                  <th>VAT</th>
                  <th>Total</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% expenses.forEach(expense => { %>
                  <tr>
                    <td><%= expense.expense_date %></td>
                    <td><strong><%= expense.description %></strong></td>
                    <td><%= expense.supplier_name || "-" %></td>
                    <td><%= expense.category_name || "-" %></td>
                    <td>£<%= Number(expense.vat_total).toFixed(2) %></td>
                    <td><strong>£<%= Number(expense.total).toFixed(2) %></strong></td>
                    <td class="actions-cell">
                      <a href="/expenses/<%= expense.id %>" class="small-link">View</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
