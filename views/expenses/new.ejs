<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <h2><%= appName %></h2>
      <p class="local-pill">Offline Private</p>

      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/invoices">Invoices</a>
        <a href="/customers">Customers</a>
        <a href="/expenses" class="active">Expenses</a>
        <a href="#">Suppliers</a>
        <a href="#">Reports</a>
        <a href="/settings">Settings</a>
      </nav>
    </aside>

    <main class="dashboard">
      <header class="dashboard-header">
        <div>
          <p class="eyebrow">New Expense</p>
          <h1>Add Expense</h1>
        </div>
        <a href="/expenses" class="btn secondary">Back</a>
      </header>

      <section class="panel">
        <form method="POST" action="/expenses/new" class="form-grid">
          <label>
            Expense date
            <input type="date" name="expense_date" required>
          </label>

          <label>
            Category
            <select name="category_account_id" required>
              <option value="">Select category</option>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>"><%= category.code %> - <%= category.name %></option>
              <% }) %>
            </select>
          </label>

          <label class="wide">
            Description
            <input type="text" name="description" placeholder="Example: Royal Mail postage" required>
          </label>

          <label>
            Total paid including VAT
            <input type="number" step="0.01" name="total" value="0" required>
          </label>

          <label>
            VAT rate %
            <input type="number" step="0.01" name="vat_rate" value="20" required>
          </label>

          <label>
            Paid from
            <select name="paid_from">
              <option value="cash">Cash</option>
              <option value="bank">Bank</option>
            </select>
          </label>

          <label>
            Supplier optional
            <select name="supplier_id">
              <option value="">No supplier selected</option>
              <% suppliers.forEach(supplier => { %>
                <option value="<%= supplier.id %>"><%= supplier.name %></option>
              <% }) %>
            </select>
          </label>

          <div class="form-actions">
            <button type="submit" class="btn primary">Save Expense</button>
          </div>
        </form>
      </section>
    </main>
  </div>
</body>
</html>
