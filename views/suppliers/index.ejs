<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <h2><%= appName %></h2>
      <p class="local-pill">Offline Private</p>

      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/invoices">Invoices</a>
        <a href="/customers">Customers</a>
        <a href="/expenses">Expenses</a>
        <a href="/suppliers" class="active">Suppliers</a>
        <a href="#">Reports</a>
        <a href="/exports">Exports</a>
        <a href="/backup">Backup</a>
        <a href="/settings">Settings</a>
      </nav>
    </aside>

    <main class="dashboard">
      <header class="dashboard-header">
        <div>
          <p class="eyebrow">People or companies you buy from</p>
          <h1>Suppliers</h1>
        </div>
        <a href="/suppliers/new" class="btn primary">Add Supplier</a>
      </header>

      <section class="panel">
        <% if (suppliers.length === 0) { %>
          <p class="muted">No suppliers yet. Add suppliers for rent, stock, software, postage or services.</p>
        <% } else { %>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Address</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% suppliers.forEach(supplier => { %>
                  <tr>
                    <td><strong><%= supplier.name %></strong></td>
                    <td><%= supplier.email || "-" %></td>
                    <td><%= supplier.phone || "-" %></td>
                    <td><%= supplier.address || "-" %></td>
                    <td class="actions-cell">
                      <a href="/suppliers/<%= supplier.id %>/edit" class="small-link">Edit</a>
                      <form method="POST" action="/suppliers/<%= supplier.id %>/delete" onsubmit="return confirm('Delete this supplier?');">
                        <button type="submit" class="danger-link">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
