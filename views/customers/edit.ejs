<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <h2><%= appName %></h2>
      <p class="local-pill">Offline Private</p>

      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/invoices">Invoices</a>
        <a href="/customers" class="active">Customers</a>
        <a href="/expenses">Expenses</a>
        <a href="#">Suppliers</a>
        <a href="#">Reports</a>
        <a href="/settings">Settings</a>
      </nav>
    </aside>

    <main class="dashboard">
      <header class="dashboard-header">
        <div>
          <p class="eyebrow">Edit Customer</p>
          <h1><%= customer.name %></h1>
        </div>
        <a href="/customers" class="btn secondary">Back</a>
      </header>

      <section class="panel">
        <form method="POST" action="/customers/<%= customer.id %>/edit" class="form-grid">
          <label>
            Customer name
            <input type="text" name="name" value="<%= customer.name || '' %>" required>
          </label>

          <label>
            Email
            <input type="email" name="email" value="<%= customer.email || '' %>">
          </label>

          <label>
            Phone
            <input type="text" name="phone" value="<%= customer.phone || '' %>">
          </label>

          <label>
            Address
            <input type="text" name="address" value="<%= customer.address || '' %>">
          </label>

          <div class="form-actions">
            <button type="submit" class="btn primary">Update Customer</button>
          </div>
        </form>
      </section>
    </main>
  </div>
</body>
</html>
