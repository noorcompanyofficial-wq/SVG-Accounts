<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="landing">
    <div class="landing-card">
      <p class="badge">Private Offline Accounting Software</p>
      <h1><%= appName %></h1>
      <p class="subtitle">
        Local invoicing, expenses, VAT tracking and business reports. Stored privately on this computer.
      </p>

      <div class="actions">
        <a href="/dashboard" class="btn primary">Open Dashboard</a>
        <a href="/settings" class="btn secondary">Company Settings</a>
      </div>

      <p class="privacy-note">
        Private mode: this software is not publicly hosted and only runs on your local machine.
      </p>
    </div>
  </main>
</body>
</html>
